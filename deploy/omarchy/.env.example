# Notra self-hosted on omarchy: secrets and settings for deploy/omarchy/compose.yaml.
# Copy to /home/evolv3ai/firstmate-homes/vibe/data/notra-deploy/.env (chmod 600),
# or point NOTRA_ENV_FILE at another path. Never commit the filled-in copy.
#
# Generate values marked "generate" with the command shown.
# The compose file sets these itself, so do not put them here:
#   APP_URL, NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_APP_URL,
#   NEXT_PUBLIC_WORKOS_REDIRECT_URI, NEXT_PUBLIC_UNLIMITED_ORGANIZATIONS,
#   NOTRA_SELF_HOSTED, UPSTASH_REDIS_REST_URL, WORKFLOW_BASE_URL

# --- Deployment ---------------------------------------------------------------
# Host port the dashboard binds on 127.0.0.1.
NOTRA_PORT=3090
# Browser URL of the dashboard: the Tailscale Serve address (see README.md).
# Must match the redirect URI registered in WorkOS
# (<NOTRA_PUBLIC_URL>/auth/callback). NEXT_PUBLIC_* values are baked in at
# build time, so rebuild after changing it.
NOTRA_PUBLIC_URL=https://omarchy.dwelf-stork.ts.net:3090
# Host port the api binds on 127.0.0.1 (Tailscale Serve publishes it).
NOTRA_API_PORT=3091

# --- Database (Postgres container) --------------------------------------------
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Same password as above; host "postgres" is the compose service.
DATABASE_URL=postgresql://notra:<POSTGRES_PASSWORD>@postgres:5432/notra

# --- Redis (Upstash REST API served by serverless-redis-http) -----------------
# generate: openssl rand -hex 32. Both must hold the same value: SRH_TOKEN is
# what the proxy accepts, UPSTASH_REDIS_REST_TOKEN is what Notra sends.
SRH_TOKEN=
UPSTASH_REDIS_REST_TOKEN=

# --- Generated application secrets --------------------------------------------
# Encrypts the AuthKit session cookie. generate: openssl rand -hex 32
WORKOS_COOKIE_PASSWORD=
# Encrypts stored integration tokens; changing it breaks saved integrations.
# generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=
# Encrypts outbound webhook secrets. generate: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=
# Authenticates internal workflow callbacks. generate: openssl rand -hex 32
INTERNAL_WORKFLOW_SECRET=
# Bearer token for /api/cron/* routes. generate: openssl rand -hex 32
CRON_SECRET=

# --- Required third-party credentials -----------------------------------------
# WorkOS AuthKit handles sign-in and sign-up; nothing past /api/healthcheck
# works without these. In the WorkOS dashboard, add the redirect URI
# <NOTRA_PUBLIC_URL>/auth/callback and keep email + password auth enabled.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# AI content generation. Organizations without a billing plan route to
# OpenRouter, so set OPENROUTER_API_KEY; the Vercel AI Gateway key is the
# fallback. Without either, the app runs but cannot generate content.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# Unkey verifies the ntra_ API keys the api accepts, and the dashboard's API
# Keys page mints them. The api does not boot without UNKEY_ROOT_KEY. Use the
# workspace that minted your existing keys: a root key from another workspace
# rejects them.
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# The api needs a QStash token at boot, even though schedules need a public
# URL to fire.
QSTASH_TOKEN=

# --- Optional integrations ------------------------------------------------------
# Notra runs without these; the matching features stay off. Uncomment and fill
# in the ones you need. The root .env.example lists every other optional
# variable (GEO engines, analytics, Slack, Tinybird, social accounts,
# observability).

# AuthKit OAuth metadata for MCP clients, and WorkOS webhooks (webhooks need a
# public URL, which this localhost deployment does not have).
# WORKOS_AUTHKIT_DOMAIN=
# WORKOS_WEBHOOK_SECRET=
# Session cookie lifetime in seconds. AuthKit defaults to 400 days.
# WORKOS_COOKIE_MAX_AGE=

# GitHub OAuth app and GitHub App: repository integrations, publishing, mentions.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=

# Transactional email (invites, digests).
# RESEND_API_KEY=

# Upstash QStash signing keys for scheduled and event-triggered content.
# Needs a public URL.
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Cloudflare R2: image and attachment uploads.
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_S3_ENDPOINT=
# CLOUDFLARE_PUBLIC_URL=
# CLOUDFLARE_BUCKET_NAME=

# Brand research and memory used during content generation.
# CONTEXT_DEV_API_KEY=
# SUPERMEMORY_API_KEY=

# Autumn billing. Leave empty: NOTRA_SELF_HOSTED skips billing gates only while
# no Autumn key is set.
# AUTUMN_SECRET_KEY=
